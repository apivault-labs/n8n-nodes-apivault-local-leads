    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; const email = j.email ?? j.primaryEmail ?? (Array.isArray(j.emails) ? j.emails[0] : ''); const phone = j.phone ?? j.telephone ?? (Array.isArray(j.phones) ? j.phones[0] : ''); return { json: { ...j, crmLead: { businessName: j.businessName ?? j.name ?? '', website: j.website ?? j.url ?? '', email, phone, location: j.address ?? j.location ?? '', leadScore: Number(j.leadScore ?? 0), reviewStatus: email || phone ? 'ready_for_review' : 'needs_contact' } } };"
