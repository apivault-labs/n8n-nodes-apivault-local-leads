{
  "name": "n8n-nodes-apivault-local-leads",
  "version": "0.1.2",
  "description": "Official n8n community node for Apivault Labs Local Lead Finder. Find local businesses or enrich your own website list with contact data, lead scores, website insights and CRM-ready output through Apify.",
  "license": "MIT",
  "homepage": "https://apify.com/apivault_labs/apify-actor-local-leads",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "local-leads",
    "lead-generation",
    "b2b-prospecting",
    "yellowpages-scraper",
    "local-seo",
    "web-agency-leads",
    "outreach-automation",
    "crm-enrichment",
    "apollo-alternative",
    "apify"
  ],
  "author": {
    "name": "apivault_labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apivault-labs/n8n-nodes-apivault-local-leads.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LocalLeads/LocalLeads.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
